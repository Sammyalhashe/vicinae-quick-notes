{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "quick-note",
  "title": "Quick Note",
  "description": "Write markdown and Org-mode notes from Vicinae",
  "icon": "icon.png",
  "author": "Sammyalhashe",
  "license": "MIT",
  "platforms": ["Linux", "macOS"],
  "commands": [
    {
      "name": "quick-note",
      "title": "Quick Note",
      "description": "Write a markdown or org note",
      "mode": "view"
    },
    {
      "name": "notes",
      "title": "Notes",
      "description": "Browse notes and manage TODOs",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "vici build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@vicinae/api": "^0.29.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "5.9.2"
  }
}
